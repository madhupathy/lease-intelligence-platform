worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;

    # Upstream hosts from env (compose service names or Railway private domains).
    # Substituted at container start via envsubst — see gateway/docker-entrypoint.sh.
    upstream extraction {
        server ${EXTRACTION_UPSTREAM};
    }

    upstream risk_engine {
        server ${RISK_ENGINE_UPSTREAM};
    }

    server {
        listen ${PORT};
        server_name _;

        # /api/alerts* → risk-engine (must precede /api/)
        location /api/alerts {
            proxy_pass         http://risk_engine;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   Authorization     $http_authorization;
        }

        # /api/auth/* → extraction
        location /api/auth/ {
            proxy_pass         http://extraction;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   Authorization     $http_authorization;
        }

        # /api/* → extraction
        location /api/ {
            proxy_pass         http://extraction;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   Authorization     $http_authorization;
        }

        # / → web static build
        location / {
            root   /usr/share/nginx/html;
            index  index.html;
            try_files $uri $uri/ /index.html;
        }
    }
}
