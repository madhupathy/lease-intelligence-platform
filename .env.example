# Copy to .env for local docker-compose. Never commit real secrets.
# On Railway, set the same names as service variables (see deploy/railway.md).

# Database (local compose uses postgres service; Railway uses Neon)
DATABASE_URL=postgresql+psycopg://lease:lease@postgres:5432/lease
STORAGE_DIR=/app/storage

# LLM / extraction
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EXTRACTION_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=text-embedding-3-small
MAX_CONTEXT_TOKENS=12000
QA_TOP_K=5
QA_MIN_SIMILARITY=0.25
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
REVIEW_THRESHOLD=0.7

# Q&A (optional — extraction succeeds without OpenAI embeddings)
ENABLE_QA=true

# Auth
JWT_SECRET=change-me-in-prod
DEMO_USER=demo
DEMO_PASSWORD=demo

# Risk engine (compose + Spring)
RISK_CRITICAL_DAYS=90
RISK_WARNING_DAYS=180
SCHEDULE_DELAY_MS=300000
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/lease
SPRING_DATASOURCE_USERNAME=lease
SPRING_DATASOURCE_PASSWORD=lease

# Gateway upstreams (compose defaults; Railway uses private domains — see deploy/railway.md)
PORT=8080
EXTRACTION_UPSTREAM=extraction:8000
RISK_ENGINE_UPSTREAM=risk-engine:8081
